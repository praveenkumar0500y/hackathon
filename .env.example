# ==============================================================================
# QML-01 Delay-Risk-Aware Fleet Dispatch: Environment Configuration
# ==============================================================================
# SECURITY INSTRUCTIONS:
# 1. Copy this template to .env: `cp .env.example .env`
# 2. NEVER commit .env to version control (.gitignore explicitly ignores it).
# 3. API keys are purely optional. If left blank, the application executes
#    transparently in verified LOCAL mode (StatevectorSimulator & local QUBO annealing).
# 4. Zero PII: Do not include personal email addresses or credentials in logs.
# ==============================================================================

# --- QpiAI Platform Credentials (Optional) ---
# Obtain Quantum Cloud API key from: https://qcloud.qpiai.tech
QPIAI_QUANTUM_API_KEY=

# Obtain Optimization API key from: https://opt.qpiai.tech
QPIAI_OPT_API_KEY=

# --- Server Network & CORS Configuration ---
# Restrict CORS to authorized development and dashboard origins.
# Comma-separated list of allowed origin URLs (default: localhost & 127.0.0.1 ports 8000, 8501, 3000, 5173)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

PORT=8000
HOST=0.0.0.0
